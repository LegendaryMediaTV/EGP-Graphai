    { "_id": "strip-punctuation", "name": "Strip trailing punctuation" },
    { "_id": "fold-case", "name": "Fold case" },
    {
      "_id": "fold-grave",
      "name": "Fold grave to acute",
      "description": "A grave replaces an acute on a final syllable because of the following word. Read the pairs off each letter's variants map (varia to oxia, psiliVaria to psiliOxia, and so on)."
    },
    {
      "_id": "lexical-accent",
      "name": "Restore the lexical accent",
      "description": "Proclitics and enclitics accent differently depending on what stands beside them. An accent can appear (ὁ becomes ὅ), disappear (ἐστίν becomes ἐστιν) or move (ἐστίν becomes ἔστιν). All three collapse to the lexical accentuation, and the positional spelling becomes a variant."
    }
