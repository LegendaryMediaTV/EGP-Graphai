  "classCategories": [
    {
      "_id": "declension",
      "name": "Declension",
      "description": "Which ending table a noun or adjective inflects by. A lexical fact: the citation form does not always show it, since ὁδός and λόγος both end in -ος and decline alike but differ in gender, while πνεῦμα and χώρα both end in -α and do not decline alike at all."
    },
    {
      "_id": "conjugation",
      "name": "Conjugation",
      "description": "Which present-system pattern a verb inflects by. Separate from the principal parts in `stems`, which say how each tense outside the present is built."
    }
  ],
