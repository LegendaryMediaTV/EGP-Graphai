\v 1 \w In|strong="H8064"\w* \w the|strong="H1254"\w* \w beginning|strong="H7225"\w* \w God|strong="H8064"\w* \w created|strong="H1254"\w* \w the|strong="H1254"\w* \w heavens|strong="H8064"\w* \w and|strong="H8064"\w* \w the|strong="H1254"\w* \w earth|strong="H8064"\w*.  
\v 11 \w And|strong="H6086"\w* God \w said|strong="H3651"\w*, \w Let|strong="H1961"\w* \w the|strong="H5921"\w* earth \w put|strong="H6213"\w* \w forth|strong="H6213"\w* \w grass|strong="H6212"\w*, \w herbs|strong="H6212"\w* \w yielding|strong="H2232"\w* \w seed|strong="H2233"\w*, \add and\add* fruit-trees \w bearing|strong="H6213"\w* \w fruit|strong="H6529"\w* \w after|strong="H5921"\w* \w their|strong="H5921"\w* \w kind|strong="H4327"\w*, wherein \w is|strong="H3651"\w* \w the|strong="H5921"\w* \w seed|strong="H2233"\w* \w thereof|strong="H6529"\w*, \w upon|strong="H5921"\w* \w the|strong="H5921"\w* earth: \w and|strong="H6086"\w* \w it|strong="H5921"\w* \w was|strong="H1961"\w* \w so|strong="H3651"\w*.  
