\v 35 \wj \+w There|strong="G1161"\+w* \+w will|strong="G1510"\+w* \+w be|strong="G1510"\+w* \+w two|strong="G1417"\+w* grinding grain \+w together|strong="G1909"\+w*. \+w One|strong="G1520"\+w* \+w will|strong="G1510"\+w* \+w be|strong="G1510"\+w* \+w taken|strong="G3880"\+w* \+w and|strong="G1161"\+w* \+w the|strong="G1161"\+w* \+w other|strong="G2087"\+w* \+w will|strong="G1510"\+w* \+w be|strong="G1510"\+w* left.”\wj*  
