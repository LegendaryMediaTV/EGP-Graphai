\v 12 \w And|strong="H3045"\w* \w as|strong="H3588"\w* \w for|strong="H3588"\w* \w me|strong="H5921"\w*, \w thou|strong="H3045"\w* upholdest \w me|strong="H5921"\w* \w in|strong="H5921"\w* \w mine|strong="H3045"\w* integrity,  
