\v 10 \w But|strong="H1571"\w* thou, \w O|strong="H3068"\w* \w Jehovah|strong="H3068"\w*, \w have|strong="H1571"\w* mercy \w upon|strong="H5921"\w* \w me|strong="H5921"\w*, \w and|strong="H3899"\w* raise \w me|strong="H5921"\w* \w up|strong="H1431"\w*,  
