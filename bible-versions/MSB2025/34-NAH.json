[
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 1,
    "content": [
      {
        "heading": {
          "text": "The Burden against Nineveh",
          "foot": { "type": "xrf", "content": { "bibleLink": "Jonah 1:1–3" } }
        }
      },
      {
        "paragraph": true,
        "text": "This is the burden against Nineveh, the book of the vision of Nahum the Elkoshite:"
      }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 2,
    "content": [
      { "paragraph": true, "text": "The " },
      { "text": "Lord", "marks": ["sc"] },
      { "text": " is a jealous and avenging God;", "break": true },
      "the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " is avenging and full of wrath.", "break": true },
      "The ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " takes vengeance on His foes", "break": true },
      { "text": "and reserves wrath for His enemies.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 3,
    "content": [
      "The ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " is slow to anger", "break": true },
      { "text": "and great in power;", "break": true },
      "the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " will by no means", "break": true },
      { "text": "leave the guilty unpunished.", "break": true },
      { "text": "His path is in the whirlwind and storm,", "break": true },
      { "text": "and clouds are the dust beneath His feet.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 4,
    "content": [
      { "text": "He rebukes the sea and dries it up;", "break": true },
      { "text": "He makes all the rivers run dry.", "break": true },
      { "text": "Bashan and Carmel wither,", "break": true },
      { "text": "and the flower of Lebanon wilts.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 5,
    "content": [
      { "text": "The mountains quake before Him,", "break": true },
      { "text": "and the hills melt away;", "break": true },
      { "text": "the earth trembles at His presence—", "break": true },
      { "text": "the world and all its dwellers.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 6,
    "content": [
      { "text": "Who can withstand His indignation?", "break": true },
      { "text": "Who can endure His burning anger?", "break": true },
      { "text": "His wrath is poured out like fire;", "break": true },
      "even rocks are shattered before Him."
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 7,
    "content": [
      { "paragraph": true, "text": "The " },
      { "text": "Lord", "marks": ["sc"] },
      { "text": " is good,", "break": true },
      { "text": "a stronghold in the day of distress;", "break": true },
      { "text": "He cares for those who trust in Him.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 8,
    "content": [
      { "text": "But with an overwhelming flood", "break": true },
      {
        "text": "He will make an end of Nineveh",
        "break": true,
        "foot": {
          "type": "trn",
          "content": ["Literally ", { "text": "of her place", "marks": ["i"] }]
        }
      },
      "and pursue His enemies into darkness."
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 9,
    "content": [
      { "paragraph": true, "text": "Whatever you plot against the " },
      { "text": "Lord", "marks": ["sc"] },
      { "text": ",", "break": true },
      { "text": "He will bring to an end.", "break": true },
      { "text": "Affliction will not rise up", "break": true },
      { "text": "a second time.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 10,
    "content": [
      { "text": "For they will be entangled as with thorns", "break": true },
      { "text": "and consumed like the drink of a drunkard—", "break": true },
      { "text": "like stubble that is fully dry.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 11,
    "content": [
      { "text": "From you, O Nineveh, comes forth", "break": true },
      "a plotter of evil against the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ",", "break": true },
      "a counselor of wickedness."
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 12,
    "content": [
      { "paragraph": true, "text": "This is what the " },
      { "text": "Lord", "marks": ["sc"] },
      " says:",
      {
        "paragraph": true,
        "text": "“Though they are allied and numerous,",
        "break": true
      },
      { "text": "yet they will be cut down and pass away.", "break": true },
      { "text": "Though I have afflicted you, O Judah,", "break": true },
      { "text": "I will afflict you no longer.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 13,
    "content": [
      {
        "text": "For I will now break their yoke from your neck",
        "break": true
      },
      "and tear away your shackles.”"
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 14,
    "content": [
      { "paragraph": true, "text": "The " },
      { "text": "Lord", "marks": ["sc"] },
      " has issued a command concerning you, O Nineveh:",
      {
        "paragraph": true,
        "text": "“There will be no descendants",
        "break": true
      },
      { "text": "to carry on your name.", "break": true },
      {
        "text": "I will cut off the carved image and cast idol",
        "break": true
      },
      { "text": "from the house of your gods;", "break": true },
      { "text": "I will prepare your grave,", "break": true },
      "for you are contemptible.”"
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 15,
    "content": [
      { "paragraph": true, "text": "Look to the mountains—", "break": true },
      { "text": "the feet of one who brings good news,", "break": true },
      { "text": "who proclaims peace!", "break": true },
      { "text": "Celebrate your feasts, O Judah;", "break": true },
      { "text": "fulfill your vows.", "break": true },
      {
        "text": "For the wicked will never again march through you;",
        "break": true
      },
      "they will be utterly cut off."
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 1,
    "content": [
      { "heading": "The Overthrow of Nineveh" },
      { "paragraph": true, "text": "One who scatters advances", "break": true },
      { "text": "against you, O Nineveh.", "break": true },
      { "text": "Guard the fortress!", "break": true },
      { "text": "Watch the road!", "break": true },
      {
        "text": "Brace yourselves!",
        "break": true,
        "foot": {
          "type": "trn",
          "content": [
            "Hebrew ",
            { "text": "Strengthen your loins!", "marks": ["i"] }
          ]
        }
      },
      "Summon all your strength!"
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 2,
    "content": [
      { "paragraph": true, "text": "For the " },
      { "text": "Lord", "marks": ["sc"] },
      { "text": " will restore the splendor of Jacob", "break": true },
      { "text": "like the splendor of Israel,", "break": true },
      { "text": "though destroyers have laid them waste", "break": true },
      "and ruined the branches of their vine."
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 3,
    "content": [
      {
        "paragraph": true,
        "text": "The shields of his mighty men are red;",
        "break": true
      },
      { "text": "the valiant warriors are dressed in scarlet.", "break": true },
      { "text": "The fittings of the chariots flash like fire", "break": true },
      { "text": "on the day they are prepared,", "break": true },
      { "text": "and the spears of cypress", "break": true },
      {
        "text": "have been brandished.",
        "break": true,
        "foot": {
          "type": "var",
          "content": [
            "Hebrew; alternately, the spears may be of ",
            { "text": "pine", "marks": ["i"] },
            " or ",
            { "text": "juniper", "marks": ["i"] },
            " or ",
            { "text": "fir", "marks": ["i"] },
            "; ",
            { "abbr": "LXX" },
            " and Syriac ",
            {
              "text": "they are prepared, and the horsemen rush to and fro.",
              "marks": ["i"]
            }
          ]
        }
      }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 4,
    "content": [
      { "text": "The chariots dash through the streets;", "break": true },
      { "text": "they rush around the plazas,", "break": true },
      { "text": "appearing like torches,", "break": true },
      { "text": "darting about like lightning.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 5,
    "content": [
      { "text": "He summons his nobles;", "break": true },
      { "text": "they stumble as they advance.", "break": true },
      { "text": "They race to its wall;", "break": true },
      { "text": "the protective shield is set in place.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 6,
    "content": [
      { "text": "The river gates are thrown open", "break": true },
      "and the palace collapses."
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 7,
    "content": [
      {
        "paragraph": true,
        "text": "It is decreed that the city be exiled",
        "break": true
      },
      { "text": "and carried away;", "break": true },
      { "text": "her maidservants moan like doves,", "break": true },
      { "text": "and beat upon their breasts.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 8,
    "content": [
      { "text": "Nineveh has been like a pool of water", "break": true },
      { "text": "throughout her days,", "break": true },
      { "text": "but now it is draining away.", "break": true },
      { "text": "“Stop! Stop!” they cry,", "break": true },
      { "text": "but no one turns back.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 9,
    "content": [
      { "text": "“Plunder the silver!", "break": true },
      { "text": "Plunder the gold!”", "break": true },
      { "text": "There is no end to the treasure,", "break": true },
      { "text": "an abundance of every precious thing.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 10,
    "content": [
      { "text": "She is emptied!", "break": true },
      { "text": "Yes, she is desolate and laid waste!", "break": true },
      { "text": "Hearts melt, knees knock,", "break": true },
      "bodies tremble, and every face grows pale!"
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 11,
    "content": [
      { "paragraph": true, "text": "Where is the lions’ lair", "break": true },
      { "text": "or the feeding ground of the young lions,", "break": true },
      {
        "text": "where the lion and lioness prowled with their cubs,",
        "break": true
      },
      { "text": "with nothing to frighten them away?", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 12,
    "content": [
      { "text": "The lion mauled enough for its cubs", "break": true },
      { "text": "and strangled prey for the lioness.", "break": true },
      { "text": "It filled its dens with the kill,", "break": true },
      "and its lairs with mauled prey."
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 13,
    "content": [
      {
        "paragraph": true,
        "text": "“Behold, I am against you,”",
        "break": true
      },
      "declares the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " of Hosts.", "break": true },
      { "text": "“I will reduce your chariots to cinders,", "break": true },
      { "text": "and the sword will devour your young lions.", "break": true },
      { "text": "I will cut off your prey from the earth,", "break": true },
      { "text": "and the voices of your messengers", "break": true },
      "will no longer be heard.”"
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 1,
    "content": [
      { "heading": "Judgment on Nineveh" },
      { "paragraph": true, "text": "Woe to the city of blood,", "break": true },
      { "text": "full of lies,", "break": true },
      { "text": "full of plunder,", "break": true },
      { "text": "never without prey.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 2,
    "content": [
      { "text": "The crack of the whip,", "break": true },
      { "text": "the rumble of the wheel,", "break": true },
      { "text": "galloping horse", "break": true },
      { "text": "and bounding chariot!", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 3,
    "content": [
      { "text": "Charging horseman,", "break": true },
      { "text": "flashing sword,", "break": true },
      { "text": "shining spear;", "break": true },
      { "text": "heaps of slain,", "break": true },
      { "text": "mounds of corpses,", "break": true },
      { "text": "dead bodies without end—", "break": true },
      { "text": "they stumble over their dead—", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 4,
    "content": [
      {
        "text": "because of the many harlotries of the harlot,",
        "break": true
      },
      { "text": "the seductive mistress of sorcery,", "break": true },
      { "text": "who betrays nations by her prostitution", "break": true },
      "and clans by her witchcraft."
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 5,
    "content": [
      {
        "paragraph": true,
        "text": "“Behold, I am against you,”",
        "break": true
      },
      "declares the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " of Hosts.", "break": true },
      { "text": "“I will lift your skirts over your face.", "break": true },
      { "text": "I will show your nakedness to the nations", "break": true },
      { "text": "and your shame to the kingdoms.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 6,
    "content": [
      { "text": "I will pelt you with filth", "break": true },
      { "text": "and treat you with contempt;", "break": true },
      { "text": "I will make a spectacle of you.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 7,
    "content": [
      { "text": "Then all who see you", "break": true },
      { "text": "will recoil from you and say,", "break": true },
      { "text": "‘Nineveh is devastated;", "break": true },
      { "text": "who will grieve for her?’", "break": true },
      { "text": "Where can I find", "break": true },
      "comforters for you?”"
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 8,
    "content": [
      {
        "paragraph": true,
        "text": "Are you better than Thebes,",
        "break": true,
        "foot": {
          "type": "trn",
          "content": ["Hebrew ", { "text": "No-amon", "marks": ["i"] }]
        }
      },
      { "text": "stationed by the Nile with water around her,", "break": true },
      { "text": "whose rampart was the sea,", "break": true },
      { "text": "whose wall was the water?", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 9,
    "content": [
      {
        "text": "Cush",
        "foot": { "type": "stu", "content": "That is, the upper Nile region" }
      },
      { "text": " and Egypt were her boundless strength;", "break": true },
      { "text": "Put and Libya were her allies.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 10,
    "content": [
      { "text": "Yet she became an exile;", "break": true },
      { "text": "she went into captivity.", "break": true },
      { "text": "Her infants were dashed to pieces", "break": true },
      { "text": "at the head of every street.", "break": true },
      { "text": "They cast lots for her dignitaries,", "break": true },
      { "text": "and all her nobles were bound in chains.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 11,
    "content": [
      { "text": "You too will become drunk;", "break": true },
      { "text": "you will go into hiding", "break": true },
      "and seek refuge from the enemy."
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 12,
    "content": [
      {
        "paragraph": true,
        "text": "All your fortresses are fig trees",
        "break": true
      },
      { "text": "with the first ripe figs;", "break": true },
      { "text": "when shaken, they fall", "break": true },
      "into the mouth of the eater!"
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 13,
    "content": [
      { "paragraph": true, "text": "Look at your troops—", "break": true },
      { "text": "they are like your women!", "break": true },
      { "text": "The gates of your land", "break": true },
      { "text": "are wide open to your enemies;", "break": true },
      "fire consumes their bars."
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 14,
    "content": [
      {
        "paragraph": true,
        "text": "Draw your water for the siege;",
        "break": true
      },
      { "text": "strengthen your fortresses.", "break": true },
      { "text": "Work the clay and tread the mortar;", "break": true },
      { "text": "repair the brick kiln!", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 15,
    "content": [
      { "text": "There the fire will devour you;", "break": true },
      { "text": "the sword will cut you down", "break": true },
      { "text": "and consume you like a young locust.", "break": true },
      { "text": "Make yourself many like the young locust;", "break": true },
      { "text": "make yourself many like the swarming locust!", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 16,
    "content": [
      { "text": "You have multiplied your merchants", "break": true },
      { "text": "more than the stars of the sky.", "break": true },
      { "text": "The young locust strips the land", "break": true },
      { "text": "and flies away.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 17,
    "content": [
      {
        "text": "Your guards",
        "foot": {
          "type": "trn",
          "content": ["Or ", { "text": "princes", "marks": ["i"] }]
        }
      },
      { "text": " are like the swarming locust,", "break": true },
      {
        "text": "and your scribes",
        "foot": {
          "type": "trn",
          "content": ["Or ", { "text": "marshals", "marks": ["i"] }]
        }
      },
      { "text": " like clouds of locusts", "break": true },
      { "text": "that settle on the walls on a cold day.", "break": true },
      { "text": "When the sun rises, they fly away,", "break": true },
      "and no one knows where."
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 18,
    "content": [
      {
        "paragraph": true,
        "text": "O king of Assyria, your shepherds slumber;",
        "break": true
      },
      { "text": "your officers sleep.", "break": true },
      { "text": "Your people are scattered on the mountains", "break": true },
      { "text": "with no one to gather them.", "break": true }
    ]
  },
  {
    "book": "NAH",
    "chapter": 3,
    "verse": 19,
    "content": [
      { "text": "There is no healing for your injury;", "break": true },
      { "text": "your wound is severe.", "break": true },
      { "text": "All who hear the news of you", "break": true },
      { "text": "applaud your downfall,", "break": true },
      { "text": "for who has not experienced", "break": true },
      "your constant cruelty?"
    ]
  }
]
