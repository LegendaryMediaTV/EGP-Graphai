[
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 1,
    "content": [
      {
        "heading": {
          "text": "Zephaniah Prophesies Judgment on Judah",
          "foot": {
            "type": "xrf",
            "content": { "bibleLink": "Matthew 13:36–43" }
          }
        }
      },
      { "paragraph": true, "text": "This is the word of the " },
      { "text": "Lord", "marks": ["sc"] },
      " that came to Zephaniah son of Cushi, the son of Gedaliah, the son of Amariah, the son of Hezekiah, in the days of Josiah son of Amon king of Judah:"
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 2,
    "content": [
      {
        "paragraph": true,
        "text": "“I will completely sweep away",
        "break": true
      },
      "everything from the face of the earth,” declares the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ".", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 3,
    "content": [
      { "text": "“I will sweep away man and beast;", "break": true },
      { "text": "I will sweep away the birds of the air,", "break": true },
      { "text": "and the fish of the sea,", "break": true },
      {
        "text": "and the idols with their wicked worshipers.",
        "break": true,
        "foot": {
          "type": "trn",
          "content": [
            "Or ",
            {
              "text": "and the idols that cause the wicked to stumble",
              "marks": ["i"]
            }
          ]
        }
      },
      { "text": "I will cut off mankind", "break": true },
      "from the face of the earth,” declares the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ".", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 4,
    "content": [
      { "text": "“I will stretch out My hand against Judah", "break": true },
      { "text": "and against all who dwell in Jerusalem.", "break": true },
      {
        "text": "I will cut off from this place every remnant of Baal,",
        "break": true
      },
      {
        "text": "the names of the idolatrous and pagan priests—",
        "break": true
      }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 5,
    "content": [
      { "text": "those who bow on the rooftops", "break": true },
      { "text": "to worship the host of heaven,", "break": true },
      "those who bow down and swear by the ",
      { "text": "Lord", "marks": ["sc"], "break": true },
      {
        "text": "but also swear by Milcom,",
        "break": true,
        "foot": {
          "type": "trn",
          "content": [
            "Or ",
            { "text": "by their king", "marks": ["i"] },
            "; ",
            { "text": "Milcom", "marks": ["i"] },
            " is a variant of ",
            { "text": "Molech", "marks": ["i"] },
            "; see ",
            { "bibleLink": "Leviticus 18:21" },
            " and ",
            { "bibleLink": "1 Kings 11:7" },
            "."
          ]
        }
      }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 6,
    "content": [
      { "text": "and those who turn back", "break": true },
      "from following the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ",", "break": true },
      "neither seeking the ",
      { "text": "Lord", "marks": ["sc"], "break": true },
      "nor inquiring of Him.”"
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 7,
    "content": [
      {
        "heading": [
          "The Day of the ",
          {
            "text": "Lord",
            "marks": ["sc"],
            "foot": {
              "type": "xrf",
              "content": [
                { "bibleLink": "Malachi 4:1–6" },
                "; ",
                { "bibleLink": "1 Thessalonians 5:1–11" },
                "; ",
                { "bibleLink": "2 Peter 3:8–13" }
              ]
            }
          }
        ]
      },
      { "paragraph": true, "text": "Be silent in the presence of the Lord " },
      { "text": "God", "marks": ["sc"] },
      { "text": ",", "break": true },
      "for the Day of the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " is near.", "break": true },
      "Indeed, the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " has prepared a sacrifice;", "break": true },
      "He has consecrated His guests."
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 8,
    "content": [
      { "paragraph": true, "text": "“On the Day of the " },
      { "text": "Lord", "marks": ["sc"] },
      { "text": "’s sacrifice", "break": true },
      { "text": "I will punish the princes,", "break": true },
      { "text": "the sons of the king,", "break": true },
      { "text": "and all who are dressed in foreign apparel.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 9,
    "content": [
      { "text": "On that day I will punish", "break": true },
      {
        "text": "all who leap over the threshold,",
        "break": true,
        "foot": {
          "type": "xrf",
          "content": ["See ", { "bibleLink": "1 Samuel 5:5" }, "."]
        }
      },
      {
        "text": "who fill the house of their master",
        "break": true,
        "foot": {
          "type": "trn",
          "content": [
            "Or ",
            { "text": "the temple of their gods", "marks": ["i"] }
          ]
        }
      },
      { "text": "with violence and deceit.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 10,
    "content": [
      "On that day,” declares the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ",", "break": true },
      { "text": "“a cry will go up from the Fish Gate,", "break": true },
      {
        "text": "a wail from the Second District,",
        "break": true,
        "foot": {
          "type": "trn",
          "content": [
            "Or ",
            { "text": "the Second Quarter", "marks": ["i"] },
            ", a newer section of Jerusalem; Hebrew ",
            { "text": "the Mishneh", "marks": ["i"] }
          ]
        }
      },
      { "text": "and a loud crashing from the hills.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 11,
    "content": [
      {
        "text": "Wail, O dwellers of the Hollow,",
        "break": true,
        "foot": {
          "type": "trn",
          "content": [
            "Or ",
            { "text": "the market district", "marks": ["i"] },
            " or ",
            { "text": "the Mortar", "marks": ["i"] }
          ]
        }
      },
      {
        "text": "for all your merchants",
        "foot": {
          "type": "trn",
          "content": [
            "Or ",
            { "text": "all the people of Canaan", "marks": ["i"] }
          ]
        }
      },
      { "text": " will be silenced;", "break": true },
      "all who weigh out silver will be cut off."
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 12,
    "content": [
      {
        "paragraph": true,
        "text": "And at that time I will search Jerusalem with lamps",
        "break": true
      },
      {
        "text": "and punish the men settled in complacency,",
        "break": true,
        "foot": {
          "type": "trn",
          "content": [
            "Or ",
            { "text": "thickening on the dregs", "marks": ["i"] }
          ]
        }
      },
      { "text": "who say to themselves,", "break": true },
      "‘The ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " will do nothing,", "break": true },
      { "text": "either good or bad.’", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 13,
    "content": [
      { "text": "Their wealth will be plundered", "break": true },
      { "text": "and their houses laid waste.", "break": true },
      { "text": "They will build houses but not inhabit them,", "break": true },
      "and plant vineyards but never drink their wine."
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 14,
    "content": [
      { "paragraph": true, "text": "The great Day of the " },
      { "text": "Lord", "marks": ["sc"] },
      { "text": " is near—", "break": true },
      { "text": "near and coming quickly.", "break": true },
      "Listen, the Day of the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": "!", "break": true },
      { "text": "Then the cry of the mighty will be bitter.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 15,
    "content": [
      { "text": "That day will be", "break": true },
      { "text": "a day of wrath,", "break": true },
      { "text": "a day of trouble and distress,", "break": true },
      { "text": "a day of destruction and desolation,", "break": true },
      { "text": "a day of darkness and gloom,", "break": true },
      { "text": "a day of clouds and blackness,", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 16,
    "content": [
      { "text": "a day of horn blast and battle cry", "break": true },
      { "text": "against the fortified cities,", "break": true },
      { "text": "and against the high corner towers.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 17,
    "content": [
      { "text": "I will bring such distress on mankind", "break": true },
      { "text": "that they will walk like the blind,", "break": true },
      "because they have sinned against the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ".", "break": true },
      { "text": "Their blood will be poured out like dust", "break": true },
      { "text": "and their flesh like dung.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 1,
    "verse": 18,
    "content": [
      { "text": "Neither their silver nor their gold", "break": true },
      { "text": "will be able to deliver them", "break": true },
      "on the Day of the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": "’s wrath.", "break": true },
      { "text": "The whole earth will be consumed", "break": true },
      "by the fire of His jealousy.”",
      {
        "paragraph": true,
        "text": "For indeed, He will make a sudden end",
        "break": true
      },
      {
        "text": "of all who dwell on the earth.",
        "foot": {
          "type": "trn",
          "content": [
            "Or ",
            { "text": "of all the people living in the land", "marks": ["i"] }
          ]
        }
      }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 1,
    "content": [
      {
        "heading": {
          "text": "A Call to Repentance",
          "foot": {
            "type": "xrf",
            "content": [
              { "bibleLink": "Joel 1:13–20" },
              "; ",
              { "bibleLink": "Amos 5:4–15" },
              "; ",
              { "bibleLink": "Luke 13:1–5" }
            ]
          }
        }
      },
      {
        "paragraph": true,
        "text": "Gather yourselves, gather together,",
        "break": true
      },
      { "text": "O shameful nation,", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 2,
    "content": [
      {
        "text": "before the decree takes effect",
        "break": true,
        "foot": {
          "type": "trn",
          "content": ["Hebrew ", { "text": "is given birth", "marks": ["i"] }]
        }
      },
      { "text": "and the day passes like chaff,", "break": true },
      "before the burning anger of the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " comes upon you,", "break": true },
      "before the Day of the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": "’s anger comes upon you.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 3,
    "content": [
      "Seek the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ", all you humble of the earth", "break": true },
      { "text": "who carry out His justice.", "break": true },
      { "text": "Seek righteousness; seek humility.", "break": true },
      { "text": "Perhaps you will be sheltered", "break": true },
      "on the day of the ",
      { "text": "Lord", "marks": ["sc"] },
      "’s anger."
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 4,
    "content": [
      {
        "heading": {
          "text": "Judgment on the Philistines",
          "foot": {
            "type": "xrf",
            "content": { "bibleLink": "Jeremiah 47:1–7" }
          }
        }
      },
      {
        "paragraph": true,
        "text": "For Gaza will be abandoned,",
        "break": true
      },
      { "text": "and Ashkelon left in ruins.", "break": true },
      { "text": "Ashdod will be driven out at noon,", "break": true },
      { "text": "and Ekron will be uprooted.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 5,
    "content": [
      { "text": "Woe to the dwellers of the seacoast,", "break": true },
      { "text": "O nation of the Cherethites!", "break": true },
      "The word of the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " is against you,", "break": true },
      { "text": "O Canaan, land of the Philistines:", "break": true },
      { "text": "“I will destroy you,", "break": true },
      { "text": "and no one will be left.”", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 6,
    "content": [
      {
        "text": "So the seacoast will become a land of pastures,",
        "break": true
      },
      {
        "text": "with wells",
        "foot": {
          "type": "trn",
          "content": [
            "Or ",
            { "text": "caves", "marks": ["i"] },
            " or ",
            { "text": "camps", "marks": ["i"] }
          ]
        }
      },
      { "text": " for shepherds and folds for sheep.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 7,
    "content": [
      {
        "text": "The coast will belong to the remnant of the house of Judah;",
        "break": true
      },
      { "text": "there they will find pasture.", "break": true },
      { "text": "They will lie down in the evening", "break": true },
      { "text": "among the houses of Ashkelon,", "break": true },
      "for the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " their God will attend to them", "break": true },
      {
        "text": "and restore their captives.",
        "foot": {
          "type": "trn",
          "content": ["Or ", { "text": "their fortunes", "marks": ["i"] }]
        }
      }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 8,
    "content": [
      {
        "heading": {
          "text": "Judgment on Moab and Ammon",
          "foot": {
            "type": "xrf",
            "content": [
              { "bibleLink": "Isaiah 16:1–14" },
              "; ",
              { "bibleLink": "Jeremiah 48:1–47" }
            ]
          }
        }
      },
      {
        "paragraph": true,
        "text": "“I have heard the reproach of Moab",
        "break": true
      },
      { "text": "and the insults of the Ammonites,", "break": true },
      { "text": "who have taunted My people", "break": true },
      { "text": "and threatened their borders.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 9,
    "content": [
      { "text": "Therefore, as surely as I live,”", "break": true },
      "declares the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " of Hosts,", "break": true },
      { "text": "the God of Israel,", "break": true },
      { "text": "“surely Moab will be like Sodom", "break": true },
      { "text": "and the Ammonites like Gomorrah—", "break": true },
      { "text": "a place of weeds and salt pits,", "break": true },
      { "text": "a perpetual wasteland.", "break": true },
      { "text": "The remnant of My people will plunder them;", "break": true },
      "the remainder of My nation will dispossess them.”"
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 10,
    "content": [
      {
        "paragraph": true,
        "text": "This they shall have in return for their pride,",
        "break": true
      },
      { "text": "for taunting and mocking the people", "break": true },
      "of the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " of Hosts.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 11,
    "content": [
      "The ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " will be terrifying to them", "break": true },
      { "text": "when He starves all the gods of the earth.", "break": true },
      { "text": "Then the nations of every shore", "break": true },
      { "text": "will bow in worship to Him,", "break": true },
      "each in its own place."
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 12,
    "content": [
      { "heading": "Judgment on Cush and Assyria" },
      {
        "paragraph": true,
        "text": "“You too, O Cushites,",
        "break": true,
        "foot": {
          "type": "stu",
          "content": "That is, people from the upper Nile region"
        }
      },
      "will be slain by My sword.”"
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 13,
    "content": [
      {
        "paragraph": true,
        "text": "And He will stretch out His hand against the north",
        "break": true
      },
      { "text": "and destroy Assyria;", "break": true },
      { "text": "He will make Nineveh a desolation,", "break": true },
      { "text": "as dry as a desert.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 14,
    "content": [
      { "text": "Herds will lie down in her midst,", "break": true },
      {
        "text": "creatures of every kind.",
        "break": true,
        "foot": {
          "type": "trn",
          "content": [
            "Hebrew ",
            { "text": "beasts of every nation", "marks": ["i"] }
          ]
        }
      },
      {
        "text": "Both the desert owl and screech owl",
        "break": true,
        "foot": {
          "type": "stu",
          "content": [
            "The precise identification of the animals rendered ",
            { "text": "desert owl", "marks": ["i"] },
            " and ",
            { "text": "screech owl", "marks": ["i"] },
            " is uncertain."
          ]
        }
      },
      { "text": "will roost atop her pillars.", "break": true },
      { "text": "Their calls will sound from the window,", "break": true },
      { "text": "but desolation will lie on the threshold,", "break": true },
      "for He will expose the beams of cedar."
    ]
  },
  {
    "book": "ZPH",
    "chapter": 2,
    "verse": 15,
    "content": [
      { "paragraph": true, "text": "This carefree city", "break": true },
      { "text": "that dwells securely,", "break": true },
      { "text": "that thinks to herself:", "break": true },
      { "text": "“I am it, and there is none besides me,”", "break": true },
      { "text": "what a ruin she has become,", "break": true },
      { "text": "a resting place for beasts.", "break": true },
      { "text": "Everyone who passes by her", "break": true },
      "hisses and shakes his fist."
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 1,
    "content": [
      { "heading": "Judgment on Jerusalem" },
      {
        "paragraph": true,
        "text": "Woe to the city of oppressors,",
        "break": true
      },
      { "text": "rebellious and defiled!", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 2,
    "content": [
      { "text": "She heeded no voice;", "break": true },
      { "text": "she accepted no correction.", "break": true },
      "She does not trust in the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ";", "break": true },
      { "text": "she has not drawn near to her God.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 3,
    "content": [
      { "text": "Her princes are roaring lions;", "break": true },
      { "text": "her judges are evening wolves,", "break": true },
      { "text": "leaving nothing for the morning.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 4,
    "content": [
      { "text": "Her prophets are reckless,", "break": true },
      { "text": "faithless men.", "break": true },
      { "text": "Her priests profane the sanctuary;", "break": true },
      { "text": "they do violence to the law.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 5,
    "content": [
      "The ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " within her is righteous;", "break": true },
      { "text": "He does no wrong.", "break": true },
      { "text": "He applies His justice morning by morning;", "break": true },
      { "text": "He does not fail at dawn,", "break": true },
      "yet the unjust know no shame."
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 6,
    "content": [
      { "heading": "Purification of the Nations" },
      {
        "paragraph": true,
        "text": "“I have cut off the nations;",
        "break": true
      },
      { "text": "their corner towers are destroyed.", "break": true },
      { "text": "I have made their streets deserted", "break": true },
      { "text": "with no one to pass through.", "break": true },
      { "text": "Their cities are laid waste,", "break": true },
      { "text": "with no man, no inhabitant.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 7,
    "content": [
      { "text": "I said, ‘Surely you will fear Me", "break": true },
      { "text": "and accept correction.’", "break": true },
      { "text": "Then her dwelling place would not be cut off", "break": true },
      { "text": "despite all for which I punished her.", "break": true },
      { "text": "But they rose early", "break": true },
      { "text": "to corrupt all their deeds.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 8,
    "content": [
      { "text": "Therefore wait for Me,”", "break": true },
      "declares the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ",", "break": true },
      { "text": "“until the day", "break": true },
      {
        "text": "I rise to testify.",
        "break": true,
        "foot": {
          "type": "var",
          "content": [
            { "abbr": "LXX" },
            " and Syriac; Hebrew ",
            { "text": "rise up to plunder", "marks": ["i"] }
          ]
        }
      },
      { "text": "For My decision is to gather nations,", "break": true },
      { "text": "to assemble kingdoms,", "break": true },
      { "text": "to pour out upon them My indignation—", "break": true },
      { "text": "all My burning anger.", "break": true },
      { "text": "For all the earth will be consumed", "break": true },
      "by the fire of My jealousy."
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 9,
    "content": [
      { "heading": "A Faithful Remnant" },
      { "paragraph": true, "text": "For then I will restore", "break": true },
      { "text": "pure lips to the peoples,", "break": true },
      "that all may call upon the name of the ",
      { "text": "Lord", "marks": ["sc"], "break": true },
      { "text": "and serve Him shoulder to shoulder.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 10,
    "content": [
      {
        "text": "From beyond the rivers of Cush",
        "break": true,
        "foot": { "type": "stu", "content": "That is, the upper Nile region" }
      },
      { "text": "My worshipers, My scattered people,", "break": true },
      { "text": "will bring Me an offering.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 11,
    "content": [
      { "text": "On that day you will not be put to shame", "break": true },
      { "text": "for any of the deeds", "break": true },
      { "text": "by which you have transgressed against Me.", "break": true },
      { "text": "For then I will remove from among you", "break": true },
      { "text": "those who rejoice in their pride,", "break": true },
      { "text": "and you will never again be haughty", "break": true },
      { "text": "on My holy mountain.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 12,
    "content": [
      {
        "text": "But I will leave within you a meek and humble people,",
        "break": true
      },
      "and they will trust in the name of the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ".", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 13,
    "content": [
      { "text": "The remnant of Israel", "break": true },
      { "text": "will no longer do wrong or speak lies,", "break": true },
      { "text": "nor will a deceitful tongue", "break": true },
      { "text": "be found in their mouths.", "break": true },
      { "text": "But they will feed and lie down,", "break": true },
      "with no one to make them tremble.”"
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 14,
    "content": [
      { "heading": "Israel’s Restoration" },
      {
        "paragraph": true,
        "text": "Sing for joy, O Daughter of Zion;",
        "break": true
      },
      { "text": "shout aloud, O Israel!", "break": true },
      { "text": "Be glad and rejoice with all your heart,", "break": true },
      { "text": "O Daughter of Jerusalem!", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 15,
    "content": [
      "The ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " has taken away your punishment;", "break": true },
      { "text": "He has turned back your enemy.", "break": true },
      "Israel’s King, the ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": ", is among you;", "break": true },
      { "text": "no longer will you fear any harm.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 16,
    "content": [
      { "text": "On that day they will say to Jerusalem:", "break": true },
      { "text": "“Do not fear, O Zion;", "break": true },
      { "text": "do not let your hands fall limp.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 17,
    "content": [
      "The ",
      { "text": "Lord", "marks": ["sc"] },
      { "text": " your God is among you;", "break": true },
      { "text": "He is mighty to save.", "break": true },
      { "text": "He will rejoice over you with gladness;", "break": true },
      {
        "text": "He will quiet you with His love;",
        "break": true,
        "foot": {
          "type": "var",
          "content": [
            "Or ",
            { "text": "He will be silent in His love", "marks": ["i"] },
            "; ",
            { "abbr": "LXX" },
            " and Syriac ",
            { "text": "He will renew you with His love", "marks": ["i"] }
          ]
        }
      },
      "He will rejoice over you with singing.”"
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 18,
    "content": [
      {
        "paragraph": true,
        "text": "“I will gather those among you who grieve",
        "break": true
      },
      { "text": "over the appointed feasts,", "break": true },
      { "text": "so that you will no longer suffer reproach.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 19,
    "content": [
      { "text": "Behold, at that time,", "break": true },
      { "text": "I will deal with all who afflict you.", "break": true },
      { "text": "I will save the lame", "break": true },
      { "text": "and gather the scattered;", "break": true },
      { "text": "and I will appoint praise and fame", "break": true },
      { "text": "for the disgraced throughout the earth.", "break": true }
    ]
  },
  {
    "book": "ZPH",
    "chapter": 3,
    "verse": 20,
    "content": [
      { "text": "At that time I will bring you in;", "break": true },
      { "text": "yes, at that time I will gather you.", "break": true },
      { "text": "For I will give you fame and praise", "break": true },
      { "text": "among all the peoples of the earth", "break": true },
      {
        "text": "when I restore your captives",
        "break": true,
        "foot": {
          "type": "trn",
          "content": ["Or ", { "text": "your fortunes", "marks": ["i"] }]
        }
      },
      "before your very eyes,” says the ",
      { "text": "Lord", "marks": ["sc"] },
      "."
    ]
  }
]
