  {
    "book": "NAH",
    "chapter": 3,
    "verse": 1,
    "content": [
      { "paragraph": true, "text": "Woe", "strong": "H1945" },
      { "text": " to the bloody", "strong": "H1818" },
      { "text": " city!", "strong": "H5892" },
