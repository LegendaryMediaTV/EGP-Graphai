    "verse": 1,
    "content": [
      { "paragraph": true, "text": "The burden", "strong": "H4853" },
      { "text": " of Nineveh.", "strong": "H5210" },
      { "text": " The book", "strong": "H5612" },
      { "text": " of the vision", "strong": "H2377" },
      { "text": " of Nahum", "strong": "H5151" },
      { "text": " the Elkoshite.", "strong": "H512" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 2,
    "content": [
      { "text": "God", "strong": "H410" },
      { "text": " [is] jealous,", "strong": "H7072" },
      {
        "content": [" and the ", { "text": "Lord", "marks": ["sc"] }],
        "strong": "H3068"
      },
      { "text": " revengeth;", "strong": "H5358", "morph": "QalActPtc" },
      {
        "content": [" the ", { "text": "Lord", "marks": ["sc"] }],
        "strong": "H3068"
      },
      { "text": " revengeth,", "strong": "H5358", "morph": "QalActPtc" },
      { "text": " and [is] furious;", "strong": "H1167" },
      { "strong": "H2534" },
      {
        "content": [" the ", { "text": "Lord", "marks": ["sc"] }],
        "strong": "H3068"
      },
      {
        "text": " will take vengeance",
        "strong": "H5358",
        "morph": "QalActPtc"
      },
      { "text": " on his adversaries,", "strong": "H6862" },
      { "text": " and he reserveth", "strong": "H5201", "morph": "QalActPtc" },
      {
        "text": " [wrath] for his enemies.",
        "strong": "H341",
        "morph": "QalActPtc"
      }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 3,
    "content": [
      {
        "content": ["The ", { "text": "Lord", "marks": ["sc"] }],
        "strong": "H3068"
      },
      { "text": " [is] slow", "strong": "H750" },
      { "text": " to anger,", "strong": "H639" },
      { "text": " and great", "strong": "H1419" },
      { "text": " in power,", "strong": "H3581" },
      { "text": " and will not at all", "strong": "H5352", "morph": "PielInf" },
      { "text": " acquit", "strong": "H5352", "morph": "PielImpf" },
      {
        "content": [" [the wicked]: the ", { "text": "Lord", "marks": ["sc"] }],
        "strong": "H3068"
      },
      { "text": " hath his way", "strong": "H1870" },
      { "text": " in the whirlwind", "strong": "H5492" },
      { "text": " and in the storm,", "strong": "H8183" },
      { "text": " and the clouds", "strong": "H6051" },
      { "text": " [are] the dust", "strong": "H80" },
      { "text": " of his feet.", "strong": "H7272" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 4,
    "content": [
      { "text": "He rebuketh", "strong": "H1605", "morph": "QalActPtc" },
      { "text": " the sea,", "strong": "H3220" },
      { "text": " and maketh it dry,", "strong": "H2717", "morph": "HiphPerf" },
      { "text": " and drieth up", "strong": "H3001", "morph": "PielImpf" },
      { "text": " all the rivers:", "strong": "H5104" },
      { "text": " Bashan", "strong": "H1316" },
      { "text": " languisheth,", "strong": "H535", "morph": "PulaPerf" },
      { "text": " and Carmel,", "strong": "H3760" },
      { "text": " and the flower", "strong": "H6525" },
      { "text": " of Lebanon", "strong": "H3844" },
      { "text": " languisheth.", "strong": "H535", "morph": "PulaPerf" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 5,
    "content": [
      { "text": "The mountains", "strong": "H2022" },
      { "text": " quake", "strong": "H7493", "morph": "QalPerf" },
      { "text": " at him, and the hills", "strong": "H1389" },
      { "text": " melt,", "strong": "H4127", "morph": "HiplPerf" },
      { "text": " and the earth", "strong": "H776" },
      { "text": " is burned", "strong": "H5375", "morph": "QalImpf" },
      { "text": " at his presence,", "strong": "H6440" },
      { "text": " yea, the world,", "strong": "H8398" },
      {
        "text": " and all that dwell",
        "strong": "H3427",
        "morph": "QalActPtc"
      },
      " therein."
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 6,
    "content": [
      { "text": "Who can stand", "strong": "H5975", "morph": "QalImpf" },
      { "text": " before", "strong": "H6440" },
      { "text": " his indignation?", "strong": "H2195" },
      { "text": " and who can abide", "strong": "H6965", "morph": "QalImpf" },
      { "text": " in the fierceness", "strong": "H2740" },
      { "text": " of his anger?", "strong": "H639" },
      { "text": " his fury", "strong": "H2534" },
      { "text": " is poured out", "strong": "H5413", "morph": "NiphPerf" },
      { "text": " like fire,", "strong": "H784" },
      { "text": " and the rocks", "strong": "H6697" },
      { "text": " are thrown down", "strong": "H5422", "morph": "NiphPerf" },
      " by him."
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 7,
    "content": [
      {
        "content": ["The ", { "text": "Lord", "marks": ["sc"] }],
        "strong": "H3068"
      },
      { "text": " [is] good,", "strong": "H2896" },
      { "text": " a strong hold", "strong": "H4581" },
      { "text": " in the day", "strong": "H3117" },
      { "text": " of trouble;", "strong": "H6869" },
      { "text": " and he knoweth", "strong": "H3045", "morph": "QalActPtc" },
      { "text": " them that trust", "strong": "H2620", "morph": "QalActPtc" },
      " in him."
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 8,
    "content": [
      {
        "text": "But with an overrunning",
        "strong": "H5674",
        "morph": "QalActPtc"
      },
      { "text": " flood", "strong": "H7858" },
      { "text": " he will make", "strong": "H6213", "morph": "QalImpf" },
      { "text": " an utter end", "strong": "H3617" },
      { "text": " of the place", "strong": "H4725" },
      { "text": " thereof, and darkness", "strong": "H2822" },
      { "text": " shall pursue", "strong": "H7291", "morph": "PielImpf" },
      { "text": " his enemies.", "strong": "H341", "morph": "QalActPtc" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 9,
    "content": [
      { "text": "What do ye imagine", "strong": "H2803", "morph": "PielImpf" },
      {
        "content": [" against the ", { "text": "Lord", "marks": ["sc"] }, "?"],
        "strong": "H3068"
      },
      { "text": " he will make", "strong": "H6213", "morph": "QalActPtc" },
      { "text": " an utter end:", "strong": "H3617" },
      { "text": " affliction", "strong": "H6869" },
      { "text": " shall not rise up", "strong": "H6965", "morph": "QalImpf" },
      { "text": " the second time.", "strong": "H6471" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 10,
    "content": [
      {
        "text": "For while [they be] folden together",
        "strong": "H5440",
        "morph": "QalPasPtc"
      },
      { "text": " [as] thorns,", "strong": "H5518" },
      {
        "text": " and while they are drunken",
        "strong": "H5433",
        "morph": "QalPasPtc"
      },
      { "text": " [as] drunkards,", "strong": "H5435" },
      {
        "text": " they shall be devoured",
        "strong": "H398",
        "morph": "PualPerf"
      },
      { "text": " as stubble", "strong": "H7179" },
      { "text": " fully", "strong": "H4392" },
      { "text": " dry.", "strong": "H3002" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 11,
    "content": [
      {
        "text": "There is [one] come out",
        "strong": "H3318",
        "morph": "QalPerf"
      },
      {
        "text": " of thee, that imagineth",
        "strong": "H2803",
        "morph": "QalActPtc"
      },
      { "text": " evil", "strong": "H7451" },
      {
        "content": [" against the ", { "text": "Lord", "marks": ["sc"] }, ","],
        "strong": "H3068"
      },
      { "text": " a wicked", "strong": "H1100" },
      { "text": " counsellor.", "strong": "H3289", "morph": "QalActPtc" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 12,
    "content": [
      { "text": "Thus saith", "strong": "H559", "morph": "QalPerf" },
      {
        "content": [" the ", { "text": "Lord", "marks": ["sc"] }, ";"],
        "strong": "H3068"
      },
      { "text": " Though [they be] quiet,", "strong": "H8003" },
      { "text": " and likewise many,", "strong": "H7227" },
      {
        "text": " yet thus shall they be cut down,",
        "strong": "H1494",
        "morph": "NiphPerf"
      },
      {
        "text": " when he shall pass through.",
        "strong": "H5674",
        "morph": "QalPerf"
      },
      {
        "text": " Though I have afflicted",
        "strong": "H6031",
        "morph": "PielPerf"
      },
      {
        "text": " thee, I will afflict",
        "strong": "H6031",
        "morph": "PielImpf"
      },
      " thee no more."
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 13,
    "content": [
      { "text": "For now will I break", "strong": "H7665", "morph": "QalImpf" },
      { "text": " his yoke", "strong": "H4132" },
      { "text": " from off thee, and will burst", "strong": "H5423" },
      { "text": " thy bonds", "strong": "H4147" },
      { "text": " in sunder.", "strong": "H5423", "morph": "PielImpf" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 14,
    "content": [
      {
        "content": ["And the ", { "text": "Lord", "marks": ["sc"] }],
        "strong": "H3068"
      },
      {
        "text": " hath given a commandment",
        "strong": "H6680",
        "morph": "PielPerf"
      },
      {
        "text": " concerning thee, [that] no more of thy name",
        "strong": "H8034"
      },
      { "text": " be sown:", "strong": "H2232", "morph": "NiphImpf" },
      { "text": " out of the house", "strong": "H1004" },
      { "text": " of thy gods", "strong": "H430" },
      { "text": " will I cut off", "strong": "H3772", "morph": "HiphImpf" },
      { "text": " the graven image", "strong": "H6459" },
      { "text": " and the molten image:", "strong": "H4541" },
      { "text": " I will make", "strong": "H7760", "morph": "QalImpf" },
      { "text": " thy grave;", "strong": "H6913" },
      { "text": " for thou art vile.", "strong": "H7043", "morph": "QalPerf" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 1,
    "verse": 15,
    "content": [
      { "text": "Behold upon the mountains", "strong": "H2022" },
      { "text": " the feet", "strong": "H7272" },
      {
        "text": " of him that bringeth good tidings,",
        "strong": "H1319",
        "morph": "PielPtc"
      },
      { "text": " that publisheth", "strong": "H8085", "morph": "HiphPtc" },
      { "text": " peace!", "strong": "H7965" },
      { "text": " O Judah,", "strong": "H3063" },
      { "text": " keep", "strong": "H2287", "morph": "QalImpv" },
      { "text": " thy solemn feasts,", "strong": "H2282" },
      { "text": " perform", "strong": "H7999", "morph": "PielImpv" },
      { "text": " thy vows:", "strong": "H5088" },
      { "text": " for the wicked", "strong": "H1100" },
      { "text": " shall no more", "strong": "H3254", "morph": "HiphImpf" },
      { "text": " pass through", "strong": "H5674", "morph": "QalInf" },
      {
        "text": " thee; he is utterly cut off.",
        "strong": "H3772",
        "morph": "NiphPerf"
      }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 1,
    "content": [
      {
        "paragraph": true,
        "text": "He that dasheth in pieces",
        "strong": "H6327",
        "morph": "HiphPtc"
      },
      { "text": " is come up", "strong": "H5927", "morph": "QalPerf" },
      { "text": " before thy face:", "strong": "H6440" },
      { "text": " keep", "strong": "H5341", "morph": "QalInf" },
      { "text": " the munition,", "strong": "H4694" },
      { "text": " watch", "strong": "H6822", "morph": "PielImpv" },
      { "text": " the way,", "strong": "H1870" },
      { "text": " make [thy] loins", "strong": "H4975" },
      { "text": " strong,", "strong": "H2388", "morph": "PielImpv" },
      { "text": " fortify", "strong": "H553", "morph": "PielImpv" },
      { "text": " [thy] power", "strong": "H3581" },
      { "text": " mightily.", "strong": "H3966" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 2,
    "content": [
      {
        "content": ["For the ", { "text": "Lord", "marks": ["sc"] }],
        "strong": "H3068"
      },
      { "text": " hath turned away", "strong": "H7725", "morph": "QalPerf" },
      { "text": " the excellency", "strong": "H1347" },
      { "text": " of Jacob,", "strong": "H3290" },
      { "text": " as the excellency", "strong": "H1347" },
      { "text": " of Israel:", "strong": "H3478" },
      { "text": " for the emptiers", "strong": "H1238", "morph": "QalActPtc" },
      {
        "text": " have emptied them out,",
        "strong": "H1238",
        "morph": "QalPerf"
      },
      { "text": " and marred", "strong": "H7843", "morph": "PielPerf" },
      { "text": " their vine branches.", "strong": "H2156" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 3,
    "content": [
      { "text": "The shield", "strong": "H4043" },
      { "text": " of his mighty men", "strong": "H1368" },
      { "text": " is made red,", "strong": "H119", "morph": "PualPtc" },
      { "text": " the valiant", "strong": "H2428" },
      { "text": " men", "strong": "H582" },
      { "text": " [are] in scarlet:", "strong": "H8529", "morph": "PualPtc" },
      { "text": " the chariots", "strong": "H7393" },
      { "text": " [shall be] with flaming", "strong": "H784" },
      { "text": " torches", "strong": "H6393" },
      { "text": " in the day", "strong": "H3117" },
      { "text": " of his preparation,", "strong": "H3559", "morph": "HiphInf" },
      { "text": " and the fir trees", "strong": "H1265" },
      {
        "text": " shall be terribly shaken.",
        "strong": "H7477",
        "morph": "HophPerf"
      }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 4,
    "content": [
      { "text": "The chariots", "strong": "H7393" },
      { "text": " shall rage", "strong": "H1984", "morph": "HipoImpf" },
      { "text": " in the streets,", "strong": "H2351" },
      {
        "text": " they shall justle one against another",
        "strong": "H8264",
        "morph": "HippImpf"
      },
      { "text": " in the broad ways:", "strong": "H7339" },
      { "text": " they shall seem", "strong": "H4758" },
      { "text": " like torches,", "strong": "H3940" },
      { "text": " they shall run", "strong": "H7323", "morph": "PoleImpf" },
      { "text": " like the lightnings.", "strong": "H1300" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 5,
    "content": [
      { "text": "He shall recount", "strong": "H2142", "morph": "QalImpf" },
      { "text": " his worthies:", "strong": "H117" },
      { "text": " they shall stumble", "strong": "H3782", "morph": "NiphImpf" },
      { "text": " in their walk;", "strong": "H1979" },
      {
        "text": " they shall make haste",
        "strong": "H4116",
        "morph": "PielImpf"
      },
      { "text": " to the wall", "strong": "H2346" },
      {
        "text": " thereof, and the defence",
        "strong": "H5526",
        "morph": "QalActPtc"
      },
      { "text": " shall be prepared.", "strong": "H3559", "morph": "HophPerf" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 6,
    "content": [
      { "text": "The gates", "strong": "H8179" },
      { "text": " of the rivers", "strong": "H5104" },
      { "text": " shall be opened,", "strong": "H6605", "morph": "NiphPerf" },
      { "text": " and the palace", "strong": "H1964" },
      { "text": " shall be dissolved.", "strong": "H4127", "morph": "NiphPerf" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 7,
    "content": [
      { "text": "And Huzzab", "strong": "H5324", "morph": "HophPerf" },
      {
        "text": " shall be led away captive,",
        "strong": "H1540",
        "morph": "PualPerf"
      },
      {
        "text": " she shall be brought up,",
        "strong": "H5927",
        "morph": "HophPerf"
      },
      { "text": " and her maids", "strong": "H519" },
      { "text": " shall lead", "strong": "H5090", "morph": "PielPtc" },
      { "text": " [her] as with the voice", "strong": "H6963" },
      { "text": " of doves,", "strong": "H3123" },
      { "text": " tabering", "strong": "H8608", "morph": "PoelPtc" },
      { "text": " upon their breasts.", "strong": "H3824" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 8,
    "content": [
      { "text": "But Nineveh", "strong": "H5210" },
      { "text": " [is] of old", "strong": "H3117" },
      { "text": " like a pool", "strong": "H1295" },
      { "text": " of water:", "strong": "H4325" },
      {
        "text": " yet they shall flee away.",
        "strong": "H5127",
        "morph": "QalPtc"
      },
      { "text": " Stand,", "strong": "H5975", "morph": "QalImpv" },
      { "text": " stand,", "strong": "H5975", "morph": "QalImpv" },
      {
        "text": " [shall they cry]; but none shall look back.",
        "strong": "H6437",
        "morph": "HiphPtc"
      }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 9,
    "content": [
      { "text": "Take ye the spoil", "strong": "H962", "morph": "QalImpv" },
      { "text": " of silver,", "strong": "H3701" },
      { "text": " take the spoil", "strong": "H962", "morph": "QalImpv" },
      { "text": " of gold:", "strong": "H2091" },
      { "text": " for [there is] none end", "strong": "H7097" },
      { "text": " of the store", "strong": "H8498" },
      { "text": " [and] glory", "strong": "H3519" },
      { "text": " out of all the pleasant", "strong": "H2532" },
      { "text": " furniture.", "strong": "H3627" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 10,
    "content": [
      { "text": "She is empty,", "strong": "H950" },
      { "text": " and void,", "strong": "H4003" },
      { "text": " and waste:", "strong": "H1110", "morph": "PualPtc" },
      { "text": " and the heart", "strong": "H3820" },
      { "text": " melteth,", "strong": "H4549", "morph": "NiphPerf" },
      { "text": " and the knees", "strong": "H1290" },
      { "text": " smite together,", "strong": "H6375" },
      { "text": " and much pain", "strong": "H2479" },
      { "text": " [is] in all loins,", "strong": "H4975" },
      { "text": " and the faces", "strong": "H6440" },
      { "text": " of them all gather", "strong": "H6908", "morph": "PielPerf" },
      { "text": " blackness.", "strong": "H6289" }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 11,
    "content": [
      { "text": "Where [is] the dwelling", "strong": "H4583" },
      { "text": " of the lions,", "strong": "H738" },
      { "text": " and the feedingplace", "strong": "H4829" },
      { "text": " of the young lions,", "strong": "H3715" },
      { "text": " where the lion,", "strong": "H738" },
      { "text": " [even] the old lion,", "strong": "H3833" },
      { "text": " walked,", "strong": "H1980", "morph": "QalPerf" },
      { "text": " [and] the lion’s", "strong": "H738" },
      { "text": " whelp,", "strong": "H1482" },
      {
        "text": " and none made [them] afraid?",
        "strong": "H2729",
        "morph": "HiphPtc"
      }
    ]
  },
  {
    "book": "NAH",
    "chapter": 2,
    "verse": 12,
    "content": [
      { "text": "The lion", "strong": "H738" },
      {
        "text": " did tear in pieces",
        "strong": "H2963",
        "morph": "QalActPtc"
      },
      { "text": " enough", "strong": "H1767" },
      { "text": " for his whelps,", "strong": "H1484" },
