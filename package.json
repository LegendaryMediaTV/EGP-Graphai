{
  "name": "egp-graphai",
  "version": "1.16.0",
  "description": "A comprehensive JSON standard for Bible resources with structured data, rich metadata including Strong’s numbers, morphological codes, lexical lemmas, and conversion tools for text and markdown formats.",
  "scripts": {
    "audit-links": "ts-node utils/auditCrossChapterLinks",
    "audit-strongs-nodes": "ts-node utils/auditStrongsNodes",
    "dev": "ts-node web/server.ts",
    "export": "ts-node utils/exportContent",
    "test": "vitest --run",
    "validate": "ts-node utils/validate"
  },
  "keywords": [
    "bible",
    "greek",
    "hebrew",
    "json",
    "lexicon",
    "morphology",
    "schema",
    "scripture",
    "strongs",
    "typescript"
  ],
  "author": "Equip God’s People",
  "license": "MIT",
  "homepage": "https://www.equipgodspeople.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/LegendaryMediaTV/EGP-Graphai"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "lodash": "^4.18.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "vitest": "^4.1.10"
  }
}
